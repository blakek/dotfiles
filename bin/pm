#!/usr/bin/env bash

##
# Wrapper script to find the package manager for the current repo and run it with the given arguments.
#
# Searches common locations:
# 1. `.tool-versions` file in the project root
# 2. Lock files in the project root (e.g. bun.lock, pnpm-lock.yaml, etc.)
# 3. Global install of bun, pnpm, yarn, or npm
#
# The only change in behavior is that if the command is `i`, it will ensure the user is logged in first.
#
# Set `DEBUG` to a non-empty value to enable debug logging (e.g. `DEBUG=1 pm --help`).
##

readonly PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

italic() {
	printf '\e[3m%s\e[0m' "$*"
}

log_info() {
	printf '\e[2m%s\e[0m\n' "$*" >&2
}

log_debug() {
	if [[ "${DEBUG-}" ]]; then
		log_info "$*"
	fi
}

log_error() {
	printf '\e[31m%s\e[0m\n' "$*" >&2
}

panic() {
	log_error "$*"
	exit 1
}

is_installed() {
	command -v "$1" &>/dev/null
}

get_package_manager_from_tool_versions() {
	local -r toolVersionsFile="$PROJECT_ROOT/.tool-versions"
	local packageManager

	if ! [[ -f "$toolVersionsFile" ]]; then
		log_debug "No .tool-versions file found in project root"
		return 1
	fi

	packageManager="$(awk '$1 ~ /^(bun|pnpm|yarn|npm)$/ { print $1; exit }' "$toolVersionsFile")"

	if [[ -z "$packageManager" ]]; then
		log_debug "No package manager found in .tool-versions file"
		return 1
	fi

	log_debug "Found package manager in .tool-versions: $packageManager"
	echo "$packageManager"
}

get_package_manager_from_lock_file() {
	local packageManager

	# Try to get the package manager from the lock file
	if [[ -f "$PROJECT_ROOT/bun.lockb" || -f "$PROJECT_ROOT/bun.lock" ]]; then
		packageManager="bun"
	elif [[ -f "$PROJECT_ROOT/pnpm-lock.yaml" ]]; then
		packageManager="pnpm"
	elif [[ -f "$PROJECT_ROOT/yarn.lock" ]]; then
		packageManager="yarn"
	elif [[ -f "$PROJECT_ROOT/package-lock.json" ]]; then
		packageManager="npm"
	else
		log_debug "No known lock file found in project root"
		return 1
	fi

	log_debug "Found $packageManager lock file in project root"
	echo "$packageManager"
}

get_package_manager_from_global_install() {
	local packageManager

	for packageManager in bun pnpm yarn npm; do
		if is_installed "$packageManager"; then
			log_debug "Found global install of $packageManager"
			echo "$packageManager"
			return
		fi
	done

	log_debug "No known package manager found globally"
	return 1
}

find_package_manager() {
	get_package_manager_from_tool_versions ||
		get_package_manager_from_lock_file ||
		get_package_manager_from_global_install
}

ensure_logged_in() {
	case "$1" in
	bun)
		bun pm whoami &>/dev/null || bunx npm login
		;;
	yarn)
		yarn npm whoami &>/dev/null || yarn npm login
		;;
	pnpm | npm)
		"$1" whoami &>/dev/null || "$1" login
		;;
	esac
}


##
# Returns the package manager for the current repo by looking for known files.
# Defaults to `bun` if none found.
# Usage: pm [args...]
##
pm() {
	local packageManager
	packageManager="$(find_package_manager)" || panic "No package manager found. Please install bun, pnpm, yarn, or npm."

	log_info "Using $(italic "$packageManager")"

	# If command is the `i` command, hijack it and ensure the user is logged in first
	if [[ "$1" == "i" ]]; then
		ensure_logged_in "$packageManager"
	fi

	exec "$packageManager" "$@"
}

pm "$@"
